APP_NAME=ContractLens API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=data/uploads
LOG_LEVEL=INFO
DATABASE_URL=postgresql://contractlens:replace-this-password@localhost:5433/contractlens
POSTGRES_PORT=5433
POSTGRES_DB=contractlens
POSTGRES_USER=contractlens
POSTGRES_PASSWORD=replace-this-password
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=180
RETRIEVAL_TOP_K=5
ANALYSIS_TOP_K=3
RAG_MIN_SIMILARITY=0.35
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=45
